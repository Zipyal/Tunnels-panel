# Скопируйте этот файл в ".env" и поменяйте, если нужно. Без него работают значения по умолчанию.

# Порт, на котором открывается панель: http://localhost:8099
PANEL_PORT=8099

# Диапазон ЛОКАЛЬНЫХ портов для туннелей (число после -L в ваших командах).
# Все ваши порты должны в него попасть. Лучше не делать диапазон больше 200 портов.
TUNNEL_PORTS=1100-1199
